{
  "name": "m4a-vm-burstable-sustained",
  "properties": {
    "displayName": "mac4azure: burstable (B-series) VMs should not run tagged-sustained workloads",
    "description": "Burstable sizes earn CPU credits for spiky work and have low sustained disk limits. A VM tagged workload=sustained on a B-series size is a right-sizing review waiting to happen. Audit only.",
    "mode": "Indexed",
    "metadata": { "category": "Compute", "version": "1.0.0", "source": "mac4azure-dugganusa" },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": { "displayName": "Effect" },
        "allowedValues": ["Audit", "Disabled"],
        "defaultValue": "Audit"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          { "field": "type", "equals": "Microsoft.Compute/virtualMachines" },
          { "field": "Microsoft.Compute/virtualMachines/sku.name", "like": "Standard_B*" },
          { "field": "tags['workload']", "equals": "sustained" }
        ]
      },
      "then": { "effect": "[parameters('effect')]" }
    }
  }
}
