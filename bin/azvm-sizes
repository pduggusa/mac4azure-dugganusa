#!/bin/bash
# azvm-sizes — compare candidate VM sizes on what a right-sizing decision needs. Read-only.
# Needs: Reader. (Prices come from Microsoft's public Retail Prices API; no credentials.)
#
#   azvm-sizes --location centralus Standard_D4as_v4 Standard_D4s_v5 Standard_D4as_v5 [--subscription S]
#
# Columns: vCPU, memory, uncached disk IOPS and MB/s (the VM-level cap), temp disk GB (0 = none; a
# temp disk is WIPED by a resize), quota headroom for the size's family in the region, retail $/month
# (730 h, Linux, pay-as-you-go), and any region restriction. Quota headroom of 0 means the resize will
# be refused at validation. Request quota first (azvm-quota).
. "$(dirname "$0")/../lib/common.sh"
need az jq curl

LOC=""; SUB=""; SIZES=""
while [ $# -gt 0 ]; do
  case "$1" in
    --location|-l) LOC="$2"; shift 2;; --subscription) SUB="$2"; shift 2;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
    -*) die "unknown option: $1";; *) SIZES="$SIZES $1"; shift;;
  esac
done
[ -n "$LOC" ] && [ -n "$SIZES" ] || die "usage: azvm-sizes --location <region> <size> [<size> ...]"
m4a_require_subscription
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT

# One usage listing, then one sku lookup per size. az calls run at most 3 at a time: five at once failed
# silently (shared token cache), so the cap is deliberate. Prices are plain HTTP and can all run together.
az_ vm list-usage -l "$LOC" -o json > "$TMP/usage.json" 2>/dev/null || die "could not read quota usage"
n=0
for s in $SIZES; do
  ( for try in 1 2; do   # one retry: laptops on flaky links see transient connection errors
      az_ vm list-skus -l "$LOC" --size "$s" --resource-type virtualMachines -o json > "$TMP/sku-$s.json" 2> "$TMP/err-$s.txt" && [ -s "$TMP/sku-$s.json" ] && break
      sleep 4
    done ) &
  ( curl -s -m 30 -G "https://prices.azure.com/api/retail/prices" \
      --data-urlencode "\$filter=serviceName eq 'Virtual Machines' and armRegionName eq '$LOC' and armSkuName eq '$s' and priceType eq 'Consumption'" \
      -o "$TMP/price-$s.json" ) &
  n=$((n+1)); [ $((n % 3)) -eq 0 ] && wait
done
wait

printf '%-22s %4s %5s %7s %6s %7s %-22s %8s  %s\n' size vCPU memGB IOPS MB/s tempGB "family quota left" '$/mo' restriction
for s in $SIZES; do
  f="$TMP/sku-$s.json"
  if [ ! -s "$f" ]; then printf '%-22s  LOOKUP FAILED (az returned nothing: %s)\n' "$s" "$(head -c 100 "$TMP/err-$s.txt" | tr '\n' ' ')"; continue; fi
  if ! jq -e '.[0]' "$f" >/dev/null 2>&1; then printf '%-22s  not offered in %s for this subscription\n' "$s" "$LOC"; continue; fi
  fam=$(jq -r '.[0].family' "$f")
  cap() { jq -r --arg k "$1" '.[0].capabilities[] | select(.name == $k) | .value' "$f" | head -1; }
  vcpu=$(cap vCPUs); mem=$(cap MemoryGB); iops=$(cap UncachedDiskIOPS); bps=$(cap UncachedDiskBytesPerSecond); tmpmb=$(cap MaxResourceVolumeMB)
  mbs=$(( ${bps:-0} / 1000000 )); tmpgb=$(( ${tmpmb:-0} / 1024 ))
  left=$(jq -r --arg fam "$fam" '.[] | select(.name.value == $fam) | "\(((.limit|tonumber) - (.currentValue|tonumber)))/\(.limit)"' "$TMP/usage.json" | head -1)
  [ -n "$left" ] || left="n/a"
  price=$(jq -r '[.Items[] | select((.productName|test("Windows")|not) and (.skuName|test("Spot|Low Priority")|not))][0].retailPrice // empty' "$TMP/price-$s.json" 2>/dev/null)
  mo="n/a"; [ -n "$price" ] && mo=$(printf '%s' "$price" | awk '{printf "%d", $1*730}')
  restr=$(jq -r 'if (.[0].restrictions|length)==0 then "-" else "RESTRICTED" end' "$f")
  printf '%-22s %4s %5s %7s %6s %7s %-22s %8s  %s\n' "$s" "$vcpu" "$mem" "$iops" "$mbs" "$tmpgb" "$fam: $left" "$mo" "$restr"
done
echo
echo "Quota left is 'free vCPUs/limit' for the family. 0 or a 0 limit means the resize is refused at validation."
